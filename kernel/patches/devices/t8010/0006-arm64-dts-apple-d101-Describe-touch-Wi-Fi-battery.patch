From 919346ed606e5a45ae8ff40c2e1e195e56b28215 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 30 Oct 2026 14:13:46 +0000
Subject: [PATCH] arm64: dts: apple: d101: Describe touch, Wi-Fi, battery and
 charging

The iPhone 7 (Intel) board matches the iPhone 7 Plus (Intel) D111 in every
pin, interrupt, PMIC function and PCIe port that these blocks use; the
d101ap and d111ap device trees from iOS 15.8.8 (19H422) differ only in
phandle numbering, the Wi-Fi module instance (elsa vs olaf), the touch
personality (C1F5D,2 vs C1F5E,2) and the panel size.

Describe D101 like D111, with the D101 Wi-Fi board type, touch firmware
name and 750x1334 panel. D101 compatibles fall back to the D111 ones, so
the existing apple-z2, bq27xxx-hdq and Wi-Fi power-sequencing drivers bind
unchanged. Charging current is limited to 1 A for the smaller battery.

Untested on hardware.
---
 arch/arm64/boot/dts/apple/t8010-d101.dts | 157 +++++++++++++++++++++++
 1 file changed, 157 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8010-d101.dts b/arch/arm64/boot/dts/apple/t8010-d101.dts
index 6a9f085..3256567 100644
--- a/arch/arm64/boot/dts/apple/t8010-d101.dts
+++ b/arch/arm64/boot/dts/apple/t8010-d101.dts
@@ -11,4 +11,161 @@
 / {
 	compatible = "apple,d101", "apple,t8010", "apple,arm-platform";
 	model = "Apple iPhone 7 (Intel)";
+
+	aliases {
+		touchscreen0 = &touchscreen;
+		wifi0 = &wifi0;
+	};
+
+	d101_battery: battery {
+		compatible = "simple-battery";
+		constant-charge-current-max-microamp = <1000000>;
+	};
+
+	wlan_vdd: regulator-wlan-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-vdd";
+		gpio = <&pmu_gpio 10 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		off-on-delay-us = <2500>;
+	};
+};
+
+&pcie0 {
+	iommu-map = <0x100 &pcie0_dart0 0 0x0 0x80000000 0x0 0x3c000000 1>,
+		    <0x200 &pcie0_dart2 0 0x0 0x80000000 0x0 0x3ffff000 1>;
+	pinctrl-0 = <&wifi_clkreq>;
+	pinctrl-names = "default";
+
+	pci@2,0 {
+		device_type = "pci";
+		reg = <0x1000 0x0 0x0 0x0 0x0>;
+		bus-range = <2 2>;
+		max-link-speed = <1>;
+		apple,manual-availability-iommu = <&pcie0_dart2 0>;
+		reset-gpios = <&pinctrl_ap 14 GPIO_ACTIVE_LOW>;
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		wifi0: wifi@0,0 {
+			compatible = "apple,d101-bcm4355-wifi", "apple,d111-bcm4355-wifi",
+				     "pci14e4,43dc";
+			reg = <0x20000 0x0 0x0 0x0 0x0>;
+			device-wake-gpios = <&pinctrl_ap 88 GPIO_ACTIVE_HIGH>;
+			vdd-supply = <&wlan_vdd>;
+			apple,antenna-sku = "XX";
+			brcm,board-type = "apple,elsa";
+		};
+	};
+};
+
+&pcie0_dart2 {
+	status = "okay";
+};
+
+&i2c0 {
+	status = "okay";
+
+	pmic@27 {
+		compatible = "apple,chestnut-pmic";
+		reg = <0x27>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		touch_hv: regulator-touch-hv {
+			compatible = "apple,chestnut-touch-hv-regulator";
+			regulator-name = "touch-hv";
+		};
+	};
+};
+
+&i2c1 {
+	charger@75 {
+		compatible = "apple,sn2400";
+		reg = <0x75>;
+
+		sn2400_charger: charger {
+			compatible = "apple,sn2400-charger";
+			monitored-battery = <&d101_battery>;
+			input-current-limit-microamp = <2000000>;
+			mux-states = <&hdq_mux 0>;
+			mux-state-names = "hdq";
+		};
+
+		hdq_mux: hdq-mux {
+			compatible = "apple,sn2400-hdq-mux";
+			#mux-state-cells = <1>;
+		};
+	};
+};
+
+&i2c2 {
+	status = "okay";
+
+	light-sensor@29 {
+		compatible = "apple,ct821", "amstaos,tsl2581";
+		reg = <0x29>;
+		interrupts-extended = <&pinctrl_ap 141 IRQ_TYPE_LEVEL_LOW>;
+	};
+};
+
+&pinctrl_ap {
+	battery_swi_pins: battery-swi-pins {
+		pinmux = <APPLE_PINMUX(173, 1)>;
+	};
+
+	wifi_clkreq: wifi-clkreq-pins {
+		pinmux = <APPLE_PINMUX(18, 1)>;
+	};
+};
+
+&serial5 {
+	pinctrl-0 = <&battery_swi_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	onewire {
+		compatible = "ti,hdq-uart";
+		mux-states = <&hdq_mux 1>;
+		mux-state-names = "hdq";
+
+		fuel-gauge {
+			compatible = "apple,d101-bq27545", "apple,d111-bq27545", "ti,bq27545-hdq";
+			monitored-battery = <&d101_battery>;
+		};
+	};
+};
+
+&spi2 {
+	cs-gpios = <&pinctrl_ap 81 GPIO_ACTIVE_LOW>;
+	dmas = <&sio 0x18>;
+	dma-names = "tx";
+	status = "okay";
+
+	touchscreen: touchscreen@0 {
+		compatible = "apple,d101-touchscreen", "apple,d111-touchscreen";
+		reg = <0>;
+		spi-max-frequency = <3000000>;
+		spi-cpol;
+		spi-cpha;
+		apple,z2-no-init-ack;
+		interrupts-extended = <&pinctrl_ap 166 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&pinctrl_ap 161 GPIO_ACTIVE_LOW>;
+		hv-supply = <&touch_hv>;
+		core-supply = <&touch_core>;
+		clocks = <&touchclk>;
+		firmware-name = "apple/dfrmtfw-d101-c1f5d-2.bin";
+		touchscreen-size-x = <750>;
+		touchscreen-size-y = <1334>;
+	};
+};
+
+&sio {
+	status = "okay";
+};
+
+&touchclk {
+	clock-frequency = <32768>;
 };
-- 
2.43.0

